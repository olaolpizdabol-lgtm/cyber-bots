# ==============================================================================
# 🤖 БОТ 1: КАНАЛ АВТОМАТИЗАЦІЯ (Головний бот для каналів, публікацій та вогників)
# ==============================================================================
# Отримайте окремий токен у @BotFather в Telegram для автоматизацій каналів:
CHANNEL_AUTOMATION_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz
# Зворотна сумісність:
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz

# ID вашого Telegram акаунта (щоб тільки ви могли керувати ботом). Дізнатися: @userinfobot
ALLOWED_TELEGRAM_USER_IDS=123456789

# Канал або група Telegram для автопостингу: @my_channel або -100123456789
TELEGRAM_TARGET_CHANNEL_ID=@your_channel_username


# ==============================================================================
# 🤖 БОТ 2: КІБЕР РИЖИЙ (Окремий бот для груп, відповідей, фото та войсів)
# ==============================================================================
# Отримайте ДРУГИЙ окремий токен у @BotFather (наприклад, для бота @CyberRizhyiBot):
CYBER_RIZHYI_BOT_TOKEN=987654321:XYZfedCBA_your_cyber_rizhyi_token

# Увімкнути роботу бота "Кібер Рижий" (true/false)
CYBER_RIZHYI_ENABLED=true

# Чи відповідати на кожне повідомлення у групі (true) чи тільки при зверненні (false)
CYBER_RIZHYI_RESPOND_ALL_GROUP_MSGS=true

# Groq API для моделі 120B та швидкої обробки голосових повідомлень (Whisper)
# Отримайте безкоштовний ключ на https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b


# ==============================================================================
# 🧠 GOOGLE GEMINI AI (Аналіз фото, генерація SEO-описів, реакції на TikTok)
# ==============================================================================
# Отримайте безкоштовно на https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# Базовий промпт для Social SEO (можна змінювати прямо з бота)
DEFAULT_AI_PROMPT="Проаналізуй контент та оптимізуй опис під пошукові запити (Social SEO 2026) для TikTok Search, Instagram Explore, YouTube Search, Pinterest та Google."


# ==============================================================================
# 🔥 АВТОМАТИЗАЦІЯ #2: TIKTOK ВОГНИКИ (STREAKS) ТА СЕРДЕЧКА
# ==============================================================================
TIKTOK_STREAKS_ENABLED=true
# Окремий SessionID особистого акаунта TikTok для вогників (не той, куди заливаються відео!):
TIKTOK_STREAKS_SESSION_ID=your_personal_tiktok_streaks_sessionid_here
# Юзернейм дівчини в TikTok (без @) для надсилання сердечок:
TIKTOK_GIRLFRIEND_USERNAME=your_girlfriend_tiktok_username
# Час щоденної відправки вогників (формат ГГ:ХХ):
TIKTOK_STREAK_SCHEDULE_TIME=10:00


# ==============================================================================
# 🗽 US / NEW YORK PROXY (Для TikTok, Reels, FB Reels, Snapchat)
# ==============================================================================
# Формат: http://username:password@ip:port або socks5://username:password@ip:port
US_NY_PROXY_URL=http://user:password@proxy-ny.example.com:8080


# ==============================================================================
# 🔴 РІВЕНЬ 1: ТОП-5 ПЛАТФОРМ ОХОПЛЕННЯ (2026)
# ==============================================================================
# 1. YouTube Shorts (Google OAuth 2.0)
YOUTUBE_CLIENT_SECRETS_FILE=credentials/youtube_client_secrets.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json

# 2. Instagram (Reels / Photo / Carousel - Mobile API Emulation)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
INSTAGRAM_SESSION_FILE=credentials/instagram_session.json

# 3. TikTok (Канал 1: Відео та контент - SessionID каналу куди заливаються відео)
TIKTOK_UPLOAD_SESSION_ID=your_tiktok_video_channel_sessionid_here
TIKTOK_SESSION_ID=your_tiktok_video_channel_sessionid_here

# 4. Facebook (Reels / Photos / Posts - Meta Graph API)
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# 5. Snapchat Spotlight (Marketing API / Creative Kit)
SNAPCHAT_ACCESS_TOKEN=your_snapchat_token
SNAPCHAT_ACCOUNT_ID=your_snapchat_account_id


# ==============================================================================
# 🌐 РІВЕНЬ 2: СИЛЬНІ ДОДАТКОВІ ПЛАТФОРМИ
# ==============================================================================
# 6. X (Twitter) (OAuth 1.0a / v2 API)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# 7. Threads (Meta Threads API)
THREADS_ACCESS_TOKEN=your_threads_access_token
THREADS_USER_ID=your_threads_user_id

# 8. Pinterest (Idea / Video Pins - API v5)
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token
PINTEREST_BOARD_ID=your_pinterest_board_id

# 9. Bluesky (AT Protocol)
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=your_app_password


# ==============================================================================
# 🛡 ANTI-DETECTION & SAFEGUARDS
# ==============================================================================
ANTI_DETECTION_CLEANING=true
STRICT_PROXY_CHECK=true
DRY_RUN_MODE=false
