{
  "version": 2,
  "rewrites": [
    { "source": "/vault/images/(.*)", "destination": "/images/$1" },
    { "source": "/vault", "destination": "/index.html" },
    { "source": "/vault/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
